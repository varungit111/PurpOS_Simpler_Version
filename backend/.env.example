# Backend application settings.
PURPOS_APP_NAME=PurpOS API
PURPOS_ENV=development

# Frontend origins used for CORS. Separate multiple origins with commas.
PURPOS_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Legacy single-origin override, still supported when PURPOS_FRONTEND_ORIGINS is unset.
PURPOS_FRONTEND_ORIGIN=http://localhost:3000

# Backend-only AI provider settings. Never expose these to the frontend.
PURPOS_AI_PROVIDER=gemini
PURPOS_AI_TIMEOUT_SECONDS=30
PURPOS_AI_FALLBACK_ENABLED=true
PURPOS_AI_RETRY_MAX_RETRIES=1
PURPOS_AI_RETRY_BACKOFF_SECONDS=0.25
PURPOS_AI_FREE_ONLY=true
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Optional OpenRouter fallback. Keep the API key backend-only.
# In free-only mode, every configured OpenRouter model must also appear in
# OPENROUTER_FREE_MODELS. Do not include paid models unless you deliberately
# set PURPOS_AI_FREE_ONLY=false for that environment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_FREE_MODELS=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PurpOS

# Assessment persistence. Memory is non-durable and intended for tests/local use.
PURPOS_ASSESSMENT_REPOSITORY=memory

# Required only when PURPOS_ASSESSMENT_REPOSITORY=supabase.
# Keep the service-role key backend-only; never expose it through NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conservative public website research for Identify / AI Detective.
PURPOS_EXTERNAL_RESEARCH_ENABLED=true
PURPOS_RESEARCH_MAX_PAGES=6
PURPOS_RESEARCH_TIMEOUT_SECONDS=8
PURPOS_RESEARCH_MAX_CONTENT_BYTES=500000
PURPOS_RESEARCH_MAX_TEXT_CHARS=12000
PURPOS_RESEARCH_REDIRECT_LIMIT=3
